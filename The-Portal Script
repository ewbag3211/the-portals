local savedPoints = {} -- daftar { name, x, y, z }

local function getRoot()
    local character = player.Character
    return character, character and character:FindFirstChild("HumanoidRootPart")
end

-- Teleport ke posisi, tetap menghadap arah yang sama
local function teleportTo(position)
    local character, rootPart = getRoot()
    if not rootPart then
        tpStatus.Text = "Karakter tidak ditemukan"
        return false
    end
    local target = position + Vector3.new(0, TP_HEIGHT, 0)
    local look = rootPart.CFrame.LookVector * Vector3.new(1, 0, 1)
    if look.Magnitude < 0.01 then
        look = Vector3.new(0, 0, -1)
    end
    character:PivotTo(CFrame.lookAt(target, target + look.Unit))
    rootPart.AssemblyLinearVelocity = Vector3.zero
    return true
end

-- Simpan ke file (kalau executor punya writefile), supaya tetap ada setelah rejoin
local function saveToFile()
    if not writefile then
        return
    end
    pcall(function()
        writefile(SAVE_FILE, HttpService:JSONEncode(savedPoints))
    end)
end

local function loadFromFile()
    if not (readfile and isfile) then
        return
    end
    pcall(function()
        if isfile(SAVE_FILE) then
            local data = HttpService:JSONDecode(readfile(SAVE_FILE))
            if type(data) == "table" then
                savedPoints = data
            end
        end
    end)
end

-- Membaca "x, y, z" dari teks, contoh "-525.92, 47.28, -181.06"
local function parseCoords(text)
    local numbers = {}
    for value in string.gmatch(text, "-?%d+%.?%d*") do
        table.insert(numbers, tonumber(value))
    end
    if #numbers >= 3 then
        return Vector3.new(numbers[1], numbers[2], numbers[3])
    end
    return nil
end

