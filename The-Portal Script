-- Membaca dan memeriksa isi kolom
local function loadSettings()
    local x = tonumber(inputX.Text)
    local y = tonumber(inputY.Text)
    local amount = tonumber(inputAmount.Text)
    local delay = tonumber(inputDelay.Text)

    if not x or not y or not amount or amount < 1 or not delay then
        return false
    end

    targetX = x
    targetY = y
    clickAmount = math.clamp(math.floor(amount), 1, MAX_CLICKS)
    clickDelay = math.max(delay, MIN_DELAY)

    inputAmount.Text = tostring(clickAmount)
    inputDelay.Text = tostring(clickDelay)
    return true
end

local function startClicker()
    if loadSettings() then
        isActive = true
        setStatus("STOP", Color3.fromRGB(120, 30, 30))
    else
        setStatus("INPUT TIDAK VALID", Color3.fromRGB(170, 110, 20))
    end
end

local function toggleClicker()
    if isActive then
        stopClicker()
    else
        startClicker()
    end
end

-- Berhenti saat kolom diklik agar input tidak bentrok
