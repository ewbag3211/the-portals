-- ==========================================================
-- FUNGSI KLIK
-- ==========================================================
local function waitFor(seconds)
    local elapsed = 0
    while elapsed < seconds do
        if not isActive or not isAlive then
            return false
        end
        elapsed += task.wait()
    end
    return isActive and isAlive
end

local function tapOnce()
    local success = pcall(function()
        VirtualInputManager:SendTouchEvent(0, 0, targetX, targetY)
        task.wait(HOLD_TIME)
        VirtualInputManager:SendTouchEvent(0, 2, targetX, targetY)
    end)

    if not success then
        stopClicker()
        setStatus("TOUCH TIDAK DIDUKUNG", Color3.fromRGB(170, 110, 20))
    end
end

local function clickOnce()
    if isMobileMode then
        tapOnce()
        return
    end

    VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, true, game, 0)
    task.wait(HOLD_TIME)
    VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, false, game, 0)
end

-- Loop: klik [jumlah] kali, tunggu [delay] detik, ulang terus sampai STOP
local function runClicks()
    local round = 0
    while isActive and isAlive do
        round += 1

        -- Klik sebanyak jumlah
        for i = 1, clickAmount do
            if not isActive or not isAlive then
                return
            end
            clickOnce()
            infoLabel.Text = string.format("Putaran %d | Klik %d/%d", round, i, clickAmount)
            if i < clickAmount and not waitFor(CLICK_GAP) then
                return
            end
        end

        -- Tunggu sampai putaran berikutnya, sambil menampilkan hitung mundur
        local remaining = clickDelay
        while remaining > 0 do
            infoLabel.Text = string.format("Putaran %d | Lanjut %.1f dtk", round, remaining)
            local step = math.min(0.1, remaining)
            if not waitFor(step) then
                return
            end
            remaining -= step
        end
    end
end

