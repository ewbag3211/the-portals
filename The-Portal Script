-- ==========================================================
-- CARI POSISI MOUSE / TOUCH
-- ==========================================================
local lastX, lastY = nil, nil

local function isInsidePanel(position)
    local panelPosition = frame.AbsolutePosition
    local panelSize = frame.AbsoluteSize
    return position.X >= panelPosition.X
        and position.X <= panelPosition.X + panelSize.X
        and position.Y >= panelPosition.Y
        and position.Y <= panelPosition.Y + panelSize.Y
end

-- Posisi mouse (PC)
table.insert(connections, UserInputService.InputChanged:Connect(function(input)
    if isMobileMode or input.UserInputType ~= Enum.UserInputType.MouseMovement then
        return
    end
    local position = UserInputService:GetMouseLocation()
    lastX, lastY = math.floor(position.X), math.floor(position.Y)
    positionLabel.Text = string.format("Mouse X: %d | Y: %d", lastX, lastY)
end))

-- Posisi sentuhan (Mobile)
local function updateTouch(touch)
    if not isMobileMode or isInsidePanel(touch.Position) then
        return
    end
    local inset = GuiService:GetGuiInset()
    lastX = math.floor(touch.Position.X + inset.X)
    lastY = math.floor(touch.Position.Y + inset.Y)
    positionLabel.Text = string.format("Touch X: %d | Y: %d", lastX, lastY)
end

table.insert(connections, UserInputService.TouchStarted:Connect(updateTouch))
table.insert(connections, UserInputService.TouchMoved:Connect(updateTouch))

local function usePosition()
    if lastX and lastY then
        inputX.Text = tostring(lastX)
        inputY.Text = tostring(lastY)
    end
end

