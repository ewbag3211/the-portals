                end

                -- Ringkasan jumlah per item
                local lines = {}
                for _, keyword in ipairs(STATUS_KEYWORDS) do
                    table.insert(lines, string.format("%s: %d", keyword, counts[keyword] or 0))
                end
                countLabel.Text = folder and table.concat(lines, "\n") or "Folder WorldItems tidak ditemukan"

                table.sort(found, function(a, b)
                    return a.distance < b.distance
                end)
                nearestLabel.Text = found[1] and string.format("Terdekat: %.0f stud", found[1].distance) or "Tidak ada di world"

                -- Daftar item terdekat + tombol TP
                for i = 1, MAX_ROWS do
                    local entry = found[i]
                    rows[i].frame.Visible = entry ~= nil
                    rows[i].position = entry and entry.position or nil
                    if entry then
                        rows[i].text.Text = string.format("%s | %.0f stud", entry.keyword, entry.distance)
                    end
                end
            end)
            task.wait(1)
        end
    end)


    -- ==========================================================
    -- RIWAYAT DROP GOLD: kapan muncul, dari SP mana, dan apakah diambil / despawn
    -- ==========================================================
    local HISTORY_SIZE = 15   -- jumlah riwayat yang disimpan & ditampilkan
    local PICKED_RANGE = 15   -- kalau hilang saat kita sedekat ini, dianggap diambil kita

    local historyTitle = makeLabel(274, 18, "Riwayat drop gold:", 13, Color3.fromRGB(255, 215, 90))

    local historyList = Instance.new("ScrollingFrame")
    historyList.Size = UDim2.new(0, 170, 0, 220)
    historyList.Position = UDim2.new(0, 15, 0, 294)
    historyList.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    historyList.BorderSizePixel = 0
    historyList.ScrollBarThickness = 5
    historyList.AutomaticCanvasSize = Enum.AutomaticSize.Y
    historyList.CanvasSize = UDim2.new(0, 0, 0, 0)
    historyList.Parent = statusPage
    Instance.new("UICorner", historyList).CornerRadius = UDim.new(0, 6)

    local historyLayout = Instance.new("UIListLayout")
    historyLayout.Padding = UDim.new(0, 2)
    historyLayout.SortOrder = Enum.SortOrder.LayoutOrder
    historyLayout.Parent = historyList

    -- Baris riwayat dibuat sekali, lalu teksnya saja yang diganti (hemat memori)
    local historyRows = {}
    for i = 1, HISTORY_SIZE do
        local row = Instance.new("TextLabel")
        row.Size = UDim2.new(1, -8, 0, 30)
        row.BackgroundTransparency = 1
        row.TextColor3 = Color3.fromRGB(220, 220, 220)
        row.Font = Enum.Font.SourceSans
        row.TextSize = 12
        row.TextWrapped = true
        row.TextXAlignment = Enum.TextXAlignment.Left
        row.TextYAlignment = Enum.TextYAlignment.Top
        row.LayoutOrder = i
        row.Visible = false
        row.Parent = historyList
        historyRows[i] = row
    end

    local history = {}          -- terbaru di depan: { time, sp, born, status, endTime }
    local entryByItem = {}      -- [item] = entri riwayat (hanya untuk item yang masih ada)

    -- Posisi semua SP (dicache, diperbarui tiap 60 detik)
    local spCache, spCacheTime = {}, 0
    local function getSpPositions()
        if os.clock() - spCacheTime < 60 and next(spCache) then
            return spCache
        end
        spCache, spCacheTime = {}, os.clock()
        local spawnFolder = workspace:FindFirstChild("Maps")
            and workspace.Maps:FindFirstChild("World")
            and workspace.Maps.World:FindFirstChild("Spawn_Ore")
        if spawnFolder then
            for _, sp in ipairs(spawnFolder:GetChildren()) do
                local part = sp:IsA("BasePart") and sp or sp:FindFirstChildWhichIsA("BasePart", true)
                if part then
                    spCache[sp.Name] = part.Position
                end
            end
        end
        return spCache
    end

    local function nearestSp(position)
        local bestName, bestDistance = "?", math.huge
        for name, spPosition in pairs(getSpPositions()) do
            local distance = (spPosition - position).Magnitude
            if distance < bestDistance then
                bestName, bestDistance = name, distance
            end
        end
        return bestName, bestDistance
    end

    local function refreshHistory()
        for i = 1, HISTORY_SIZE do
            local entry = history[i]
            historyRows[i].Visible = entry ~= nil
            if entry then
                local status, color
                if entry.status == "ada" then
                    status = string.format("MASIH ADA (%ds)", math.floor(os.clock() - entry.born))
                    color = Color3.fromRGB(255, 215, 90)
                elseif entry.status == "diambil" then
                    status = string.format("diambil kamu (%ds)", entry.lifetime)
                    color = Color3.fromRGB(150, 255, 170)
                else
                    status = string.format("HILANG/despawn (%ds)", entry.lifetime)
                    color = Color3.fromRGB(255, 120, 120)
                end
                historyRows[i].Text = string.format("%s | %s\n%s", entry.time, entry.sp, status)
                historyRows[i].TextColor3 = color
            end
        end
    end

    local function isGold(item)
        local part = item:IsA("Model") and (item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart", true))
            or (item:IsA("BasePart") and item)
        return matchKeyword((part and part.Name or "") .. " " .. item.Name) ~= nil, part
    end

    local function onItemAdded(item)
        task.wait(0.1) -- tunggu PrimaryPart sempat termuat
        local gold, part = isGold(item)
        if not gold or not part then
            return
        end
        local spName, spDistance = nearestSp(part.Position)
        local entry = {
            time = os.date("%H:%M:%S"),
            sp = string.format("%s (%.0f stud)", spName, spDistance),
            born = os.clock(),
            status = "ada",
            lastPosition = part.Position,
        }
        entryByItem[item] = entry
        table.insert(history, 1, entry)
        if #history > HISTORY_SIZE then
            table.remove(history) -- buang yang paling lama
        end
        print(string.format("[GOLD] %s muncul dekat %s", entry.time, entry.sp))
        refreshHistory()
    end

    local function onItemRemoved(item)
        local entry = entryByItem[item]
        if not entry then
            return
        end
        entryByItem[item] = nil
        entry.lifetime = math.floor(os.clock() - entry.born)

        -- Dianggap diambil kita kalau karakter dekat saat item hilang
        local _, rootPart = getRoot()
        local near = rootPart and (rootPart.Position - entry.lastPosition).Magnitude <= PICKED_RANGE
        entry.status = near and "diambil" or "hilang"
        if not near then
            print(string.format("[GOLD] %s dekat %s HILANG setelah %ds (bukan diambil kamu)",
                entry.time, entry.sp, entry.lifetime))
        end
        refreshHistory()
    end

    -- Pantau WorldItems: catat setiap gold yang muncul & hilang
    task.spawn(function()
        local folder = workspace:WaitForChild("WorldItems", 30)
        if not folder or not isAlive then
            return
        end
        for _, item in ipairs(folder:GetChildren()) do
            task.spawn(onItemAdded, item) -- gold yang sudah ada saat toolkit dijalankan
        end
        table.insert(connections, folder.ChildAdded:Connect(function(item)
            task.spawn(onItemAdded, item)
        end))
        table.insert(connections, folder.ChildRemoved:Connect(onItemRemoved))
    end)

    -- Perbarui umur "MASIH ADA" tiap 2 detik
    task.spawn(function()
        while isAlive do
            if statusFrame.Visible and history[1] then
                refreshHistory()
            end
            task.wait(2)
        end
    end)

    table.insert(connections, statusCloseButton.Activated:Connect(function()
        statusFrame.Visible = false
    end))
    table.insert(connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed or UserInputService:GetFocusedTextBox() then
            return
        end
        if input.KeyCode == Enum.KeyCode.G then
            statusFrame.Visible = not statusFrame.Visible
        end
    end))
end

