    local function getOreCFrame(ore)
        if ore:IsA("BasePart") then
            return ore.CFrame
        end
        if ore:IsA("Model") then
            if ore.PrimaryPart then
                return ore.PrimaryPart.CFrame
            end
            return (ore:GetBoundingBox())
        end
        return nil
    end

    -- Hasil: daftar { name, ore, position }
    local function scanOres()
        local spawnFolder = workspace:FindFirstChild("Maps")
            and workspace.Maps:FindFirstChild("World")
            and workspace.Maps.World:FindFirstChild("Spawn_Ore")

        if not spawnFolder then
            return nil
        end

        local results = {}
        for _, spawnPoint in ipairs(spawnFolder:GetChildren()) do
            -- Ambil semua jenis ore: Ore_Stone, Ore_Iron, Ore_Gold, dst.
            for _, oreType in ipairs(spawnPoint:GetChildren()) do
                if oreType.Name:sub(1, 4) == "Ore_" then
                    local ore = oreType:FindFirstChild("Ore")
                    local cframe = ore and getOreCFrame(ore)
                    if cframe then
                        table.insert(results, {
                            name = spawnPoint.Name,              -- dipakai untuk Skip / MARK
                            oreType = oreType.Name:sub(5),       -- contoh: "Stone", "Iron"
                            ore = ore,
                            position = cframe.Position,
                        })
                    end
                end
            end
        end
        return results
    end

    -- Mengecek apakah ada pemain lain di sekitar sebuah posisi
    local function getNearbyPlayer(position)
        if PLAYER_RADIUS <= 0 then
            return nil
        end
        for _, other in ipairs(Players:GetPlayers()) do
            if other ~= player then
                local otherCharacter = other.Character
                local otherRoot = otherCharacter and otherCharacter:FindFirstChild("HumanoidRootPart")
                if otherRoot and (otherRoot.Position - position).Magnitude <= PLAYER_RADIUS then
                    return other
                end
            end
        end
        return nil
    end

    -- Membaca kolom Skip menjadi daftar nama, contoh "SP3, SP12" -> { "SP3", "SP12" }
    local function readIgnoreList()
        local list = {}
        for name in string.gmatch(inputIgnore.Text, "[^,%s]+") do
            if not table.find(list, name) then
                table.insert(list, name)
            end
        end
        return list
    end

    -- Memilih ore terdekat yang tidak dilewati, tidak di-mark, dan tidak ada pemain lain di dekatnya.
    -- Prioritas: jenis selain LOW_PRIORITY_TYPES (misal Ore_Stone) dulu; Stone hanya kalau tidak ada yang lain.
    local function pickNearestOre(results, fromPosition)
        local now = os.clock()
        local ignoreList = readIgnoreList()
        local best, bestDistance = nil, math.huge          -- jenis prioritas (selain Stone)
        local backup, backupDistance = nil, math.huge      -- jenis prioritas rendah (Stone)

        for _, entry in ipairs(results) do
            local skipUntil = skipped[entry.ore]
            local isMarked = table.find(ignoreList, entry.name) ~= nil
            if not isMarked and (not skipUntil or now >= skipUntil) and not getNearbyPlayer(entry.position) then
                local distance = (entry.position - fromPosition).Magnitude
                if table.find(LOW_PRIORITY_TYPES, entry.oreType) then
                    if distance < backupDistance then
                        backup, backupDistance = entry, distance
                    end
                elseif distance < bestDistance then
                    best, bestDistance = entry, distance
                end
            end
        end
        return best or backup
    end

