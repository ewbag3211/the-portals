    -- Alur: scan semua Ore_* > teleport > klik > tunggu ore hilang > tunggu drop hilang > ulang > teleport ke ore terdekat > klik di X,Y > tunggu > scan lagi > ulang
    -- Tombol UI atau 0 = start/stop | P = ambil posisi mouse | X = mark + skip SP ini | End = matikan script

    local Players = game:GetService("Players")
    local VirtualInputManager = game:GetService("VirtualInputManager")
    local UserInputService = game:GetService("UserInputService")
    local CoreGui = game:GetService("CoreGui")
    local GuiService = game:GetService("GuiService")
    local RunService = game:GetService("RunService")

    local player = Players.LocalPlayer

    -- ==========================================================
    -- PENGATURAN
    -- ==========================================================
    local HOLD_TIME = 0.05    -- lama klik ditahan
    local CLICK_GAP = 0.15    -- jeda antar klik di satu ore
    local EMPTY_WAIT = 2      -- jeda scan ulang saat tidak ada ore
    local SKIP_TIME = 30      -- ore yang tidak habis dilewati selama ini (detik)
    local PLAYER_RADIUS = 200   -- ore dilewati jika ada pemain lain sejauh ini (stud). 0 = matikan
    local SHOW_RADIUS = true   -- tampilkan bola radius di sekitar karakter-mu (hanya terlihat olehmu)
    local SHOW_PLAYERS = true  -- tandai pemain lain dalam radius (outline merah + nama & jarak)
    local SHOW_TARGET = true   -- tandai ore yang sedang ditambang (outline kuning)
    local CAMERA_MAX_ZOOM = 150 -- batas zoom out kamera (stud). nil = ikut aturan game

    -- Ambil drop saat OFF
