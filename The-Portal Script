    -- Teleport karakter ke atas ore, menghadap arah yang sama
    local function teleportTo(position, height)
        local character = player.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        if not rootPart then
            return false
        end

        local target = position + Vector3.new(0, height, 0)
        local lookDirection = rootPart.CFrame.LookVector * Vector3.new(1, 0, 1)
        if lookDirection.Magnitude < 0.01 then
            lookDirection = Vector3.new(0, 0, -1)
        end

        character:PivotTo(CFrame.lookAt(target, target + lookDirection.Unit))
        rootPart.AssemblyLinearVelocity = Vector3.zero -- cegah terlempar setelah teleport
        return true
    end

