    local givenUpDrops = {} -- [item] = true: drop yang gagal diambil, tidak ditunggu lagi

    -- ==========================================================
    -- AMBIL DROP (workspace.WorldItems)
    -- ==========================================================
    local function findDrops(center)
        local folder = workspace:FindFirstChild("WorldItems")
        if not folder then
            return {}
        end

        local found = {}
        for _, item in ipairs(folder:GetChildren()) do
            local part = item:IsA("Model") and item.PrimaryPart
                or (item:IsA("BasePart") and item)
            if part and not givenUpDrops[item] and (not PICKUP_PART_NAME or part.Name == PICKUP_PART_NAME) then
                local distance = (part.Position - center).Magnitude
                if distance <= PICKUP_RADIUS then
                    table.insert(found, { item = item, part = part, distance = distance })
                end
            end
        end
        table.sort(found, function(a, b)
            return a.distance < b.distance
        end)
        return found
    end

    -- Berdiri di samping item, menghadap ke item
    local function approachDrop(part)
        local character = player.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        if not rootPart then
            return false
        end

        local flat = (rootPart.Position - part.Position) * Vector3.new(1, 0, 1)
        local away = flat.Magnitude > 0.1 and flat.Unit or Vector3.new(0, 0, 1)
        local standAt = part.Position + away * PICKUP_DISTANCE + Vector3.new(0, 3, 0)
        local lookAt = Vector3.new(part.Position.X, standAt.Y, part.Position.Z)

        character:PivotTo(CFrame.lookAt(standAt, lookAt))
        rootPart.AssemblyLinearVelocity = Vector3.zero
        return true
    end

    -- Ambil pickupId dari item, contoh nama "pickup_10940_1794084692"
    local function getPickupId(item)
        if item.Name:sub(1, 7) == "pickup_" then
            return item.Name
        end
        local attribute = item:GetAttribute("pickupId")
        if type(attribute) == "string" then
            return attribute
        end
        return nil
    end

    -- Remote pickup dari game (dicari sekali, lalu disimpan)
    local pickupRemote = nil
    local function getPickupRemote()
        if pickupRemote and pickupRemote.Parent then
            return pickupRemote
        end
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local inventory = remotes and remotes:FindFirstChild("Inventory")
        pickupRemote = inventory and inventory:FindFirstChild("RequestPickupItem")
        return pickupRemote
    end

    local function requestPickup(item)
        local pickupId = getPickupId(item)
        local remote = getPickupRemote()
        if not pickupId or not remote then
            return false
        end
        local ok = pcall(function()
            remote:FireServer({ pickupId = pickupId })
        end)
        return ok
    end

    -- Klik tepat di posisi item di layar (bukan X,Y tetap)
    local function clickDrop(part)
        local camera = workspace.CurrentCamera
        local screenPoint, onScreen = camera:WorldToViewportPoint(part.Position)
        if not onScreen then
            return false
        end
        return clickOnce(math.floor(screenPoint.X), math.floor(screenPoint.Y))
    end

    -- Hasil false = miner dihentikan di tengah jalan
    collectDrops = function(center)
        if not PICKUP_ENABLED then
            return true
        end

        local character = player.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        if not rootPart then
            return true
        end

        local drops = findDrops(center or rootPart.Position)
        for index, drop in ipairs(drops) do
            if not drop.item.Parent then
                continue -- sudah diambil (oleh kita atau orang lain)
            end

            setStatus(string.format("Ambil drop %d/%d | %s", index, #drops, drop.item.Name))
            approachDrop(drop.part)
            if not waitFor(0.25) then return false end

            if PICKUP_USE_REMOTE and getPickupId(drop.item) then
                -- Minta pickup lewat remote, kirim ulang sampai item hilang
                local tries = 0
                while drop.item.Parent and tries < PICKUP_MAX_TRY do
                    tries += 1
                    if not requestPickup(drop.item) then
                        setStatus("Remote pickup tidak ditemukan, pakai klik")
                        break
                    end
                    if not waitFor(PICKUP_RETRY) then return false end
                end
            end

            -- Cadangan: klik item di layar kalau remote tidak dipakai atau gagal
            for _ = 1, PICKUP_CLICKS do
                if not drop.item.Parent then
                    break
                end
                if not clickDrop(drop.part) then
                    break -- item tidak terlihat di layar
                end
                if not waitFor(0.2) then return false end
            end

            if not drop.item.Parent then
                picked += 1
            else
                givenUpDrops[drop.item] = true -- gagal diambil, jangan ditunggu terus
            end
        end
        return true
    end

    -- Cari drop prioritas terdekat di seluruh WorldItems (tanpa batas radius)
    findPriorityDrop = function(fromPosition)
        local folder = workspace:FindFirstChild("WorldItems")
        if not folder then
            return nil
        end
        local best, bestDistance = nil, math.huge
        for _, item in ipairs(folder:GetChildren()) do
            local part = item:IsA("Model") and item.PrimaryPart or (item:IsA("BasePart") and item)
            local isPriority = false
            if part then
                local lowerName = part.Name:lower()
                for _, keyword in ipairs(PRIORITY_DROP_PARTS) do
                    if lowerName:find(keyword:lower(), 1, true) then
                        isPriority = true
                        break
                    end
                end
            end
            if isPriority and not givenUpDrops[item] then
                local distance = (part.Position - fromPosition).Magnitude
                if distance < bestDistance then
                    best, bestDistance = { item = item, part = part }, distance
                end
            end
        end
        return best
    end

    local function mineOnce()
        -- 1. Scan
        local results = scanOres()
        if not results then
            stopMiner("Folder Spawn_Ore tidak ditemukan")
            return
        end

        local character = player.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        if not rootPart then
            setStatus("Menunggu karakter...")
            waitFor(1)
            return
        end

        -- 0. Drop prioritas di WorldItems? Teleport ke sana dan tunggu sampai hilang.
        local priority = findPriorityDrop(rootPart.Position)
        if priority then
            markTarget(nil)
            setStatus("Drop prioritas! Ke " .. priority.part.Name)
            approachDrop(priority.part)
            local deadline = os.clock() + PRIORITY_WAIT_MAX
            while priority.item.Parent do
                if os.clock() >= deadline then
                    givenUpDrops[priority.item] = true -- tidak hilang-hilang: lepaskan
                    break
                end
                toggleButton.Text = string.format("OFF | tunggu drop prioritas (%d)",
                    math.ceil(deadline - os.clock()))
                toggleButton.BackgroundColor3 = Color3.fromRGB(170, 140, 20)
                -- Coba ambil sekalian (kalau pengambilan drop aktif)
                if PICKUP_ENABLED and PICKUP_USE_REMOTE then
                    requestPickup(priority.item)
                end
                if not waitFor(1) then
                    return
                end
            end
            if not priority.item.Parent then
                picked += 1
            end
            toggleButton.Text = "STOP"
            toggleButton.BackgroundColor3 = Color3.fromRGB(120, 30, 30)
            return -- putaran berikutnya: cek prioritas lagi, lalu lanjut ore
        end

        local target = pickNearestOre(results, rootPart.Position)
        if not target then
            setStatus(string.format("Tidak ada ore kosong (%d total). Scan ulang...", #results))
            waitFor(EMPTY_WAIT)
            return
        end

        -- Cek terakhir tepat sebelum teleport, kalau-kalau ada pemain baru datang
        local blocker = getNearbyPlayer(target.position)
        if blocker then
            setStatus(target.name .. " ada " .. blocker.Name .. ", cari SP lain")
            waitFor(0.2)
            return
        end

        -- 2. Teleport ke ore
        markTarget(target)
        currentTarget = target
        setStatus("Ke " .. target.name .. " (" .. target.oreType .. ")")
        teleportTo(target.position, settings.height)
        if not waitFor(0.3) then return end -- beri waktu karakter mendarat

        -- 3. Klik di X,Y sampai ore habis atau jumlah klik tercapai
        for i = 1, settings.clicks do
            if not target.ore.Parent then
                break -- ore sudah hilang, berarti tertambang
            end
            setStatus(string.format("Mining %s (%s) | F %d/%d | total %d", target.name, target.oreType, i, settings.clicks, mined))
            -- Tekan F (bukan klik mouse di X,Y)
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
            task.wait(HOLD_TIME)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
            if not waitFor(CLICK_GAP) then return end
        end

        -- 4. OFF: tunggu sampai ore hilang, tanpa batas waktu. Ore hilang = ON lagi.
        inCooldown = true
        toggleButton.Text = "OFF | tunggu ore hilang"
        toggleButton.BackgroundColor3 = Color3.fromRGB(170, 110, 20)

        -- Batas waktu diambil dari kolom "Timeout ore hilang" (bisa diubah saat jalan)
        local oreTimeout = TYPE_TIMEOUTS[target.oreType] or settings.waitTime
        local oreDeadline = os.clock() + oreTimeout
        while target.ore.Parent do
            local left = oreDeadline - os.clock()
            if left <= 0 then
                -- Ore tidak hilang dalam batas waktu: lewati sementara, lalu ON lagi
                skipped[target.ore] = os.clock() + SKIP_TIME
                setStatus(string.format("%s tidak hilang dalam %.0f dtk, lanjut", target.name, oreTimeout))
                inCooldown = false
                if not loadSettings() then
                    stopMiner("Input tidak valid, cek kolom")
                    return
                end
                toggleButton.Text = "STOP"
                toggleButton.BackgroundColor3 = Color3.fromRGB(120, 30, 30)
                return
            end
            toggleButton.Text = string.format("OFF | tunggu ore hilang (%d)", math.ceil(left))
            setStatus(string.format("%s (%s) | tunggu hilang | ore %d", target.name, target.oreType, mined))
            if not waitFor(0.2) then
                inCooldown = false
                return
            end
        end
        mined += 1

        -- 5. Tunggu drop hilang. Drop bisa muncul sedikit telat setelah ore hancur,
        --    jadi beri jeda singkat (DROP_GRACE) sebelum memutuskan "tidak ada drop".
        local graceUntil = os.clock() + DROP_GRACE
        while true do
            local drops = findDrops(target.position)

            if #drops > 0 then
                if PICKUP_ENABLED then
                    toggleButton.Text = string.format("OFF | ambil %d drop", #drops)
                    if not collectDrops(target.position) then
                        inCooldown = false
                        return
                    end
                else
                    toggleButton.Text = string.format("OFF | tunggu %d drop hilang", #drops)
                end
            elseif os.clock() >= graceUntil then
                break -- ore hilang dan drop sudah habis: ON lagi
            else
                toggleButton.Text = "OFF | cek drop"
            end

            setStatus(string.format("%s (%s) | ore %d", target.name, target.oreType, mined))
            if not waitFor(0.2) then
                inCooldown = false
                return
            end
        end
        inCooldown = false

        -- ON lagi: baca ulang kolom, siapa tahu diedit selama OFF
        if not loadSettings() then
            stopMiner("Input tidak valid, cek kolom")
            return
        end
        toggleButton.Text = "STOP"
        toggleButton.BackgroundColor3 = Color3.fromRGB(120, 30, 30)
    end

    -- ==========================================================
    -- VISUAL RADIUS (bola transparan mengikuti karakter-mu)
    -- ==========================================================
    local radiusBall = nil
    if SHOW_RADIUS and PLAYER_RADIUS > 0 then
        radiusBall = Instance.new("Part")
        radiusBall.Name = "AutoMinerRadius"
        radiusBall.Shape = Enum.PartType.Ball
        radiusBall.Size = Vector3.new(PLAYER_RADIUS * 2, PLAYER_RADIUS * 2, PLAYER_RADIUS * 2) -- diameter = 2x radius
        radiusBall.Material = Enum.Material.ForceField
        radiusBall.Color = Color3.fromRGB(80, 170, 255)
        radiusBall.Transparency = 0.3
        radiusBall.Anchored = true
        radiusBall.CanCollide = false
        radiusBall.CanQuery = false
        radiusBall.CanTouch = false
        radiusBall.CastShadow = false
        radiusBall.Parent = workspace

        table.insert(connections, RunService.RenderStepped:Connect(function()
            local character = player.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            if rootPart then
                radiusBall.CFrame = CFrame.new(rootPart.Position)
            end
        end))
    end

    -- ==========================================================
    -- OVERLAY: PEMAIN LAIN DI SEKITAR
    -- ==========================================================
    local playerMarks = {} -- [player] = { highlight, billboard, label }

    local function removeMark(other)
        local mark = playerMarks[other]
        if mark then
            mark.highlight:Destroy()
            mark.billboard:Destroy()
            playerMarks[other] = nil
        end
    end

    local function getMark(other, character)
        local mark = playerMarks[other]
        if mark and mark.character == character then
            return mark
        end
        removeMark(other)

        local highlight = Instance.new("Highlight")
        highlight.FillColor = Color3.fromRGB(255, 60, 60)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.6
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Adornee = character
        highlight.Parent = gui

        local billboard = Instance.new("BillboardGui")
        billboard.Size = UDim2.new(0, 160, 0, 36)
        billboard.StudsOffset = Vector3.new(0, 3.5, 0)
        billboard.AlwaysOnTop = true
        billboard.Adornee = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
        billboard.Parent = gui

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(255, 120, 120)
        label.TextStrokeTransparency = 0.3
        label.Font = Enum.Font.SourceSansBold
        label.TextSize = 14
        label.Parent = billboard

        mark = { character = character, highlight = highlight, billboard = billboard, label = label }
        playerMarks[other] = mark
        return mark
    end

    local function updatePlayerMarks()
        local myCharacter = player.Character
        local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

        for _, other in ipairs(Players:GetPlayers()) do
            if other ~= player then
                local character = other.Character
                local root = character and character:FindFirstChild("HumanoidRootPart")
                local distance = (myRoot and root) and (root.Position - myRoot.Position).Magnitude or math.huge

                if SHOW_PLAYERS and root and distance <= PLAYER_RADIUS then
                    local mark = getMark(other, character)
                    mark.label.Text = string.format("%s\n%.0f stud", other.Name, distance)
                else
                    removeMark(other)
                end
            end
        end

        -- Bersihkan tanda pemain yang sudah keluar dari server
        for other in pairs(playerMarks) do
            if other.Parent ~= Players then
                removeMark(other)
            end
        end
    end

    task.spawn(function()
        while isAlive do
            pcall(updatePlayerMarks)
            task.wait(0.3)
        end
    end)

    -- ==========================================================
    -- KAMERA: BOLEH ZOOM LEBIH JAUH
    -- ==========================================================
    local originalMaxZoom = player.CameraMaxZoomDistance

    if CAMERA_MAX_ZOOM then
        -- Dipasang terus, karena sebagian game mengembalikan batas zoom-nya
        task.spawn(function()
            while isAlive do
                if player.CameraMaxZoomDistance < CAMERA_MAX_ZOOM then
                    player.CameraMaxZoomDistance = CAMERA_MAX_ZOOM
                end
                task.wait(0.5)
            end
        end)
    end

    -- ==========================================================
    -- MEMATIKAN SCRIPT
    -- ==========================================================
    local function stopScript()
        isActive = false
        isAlive = false
        for other in pairs(playerMarks) do
            removeMark(other)
        end
        pcall(function()
            player.CameraMaxZoomDistance = originalMaxZoom
        end)
        if radiusBall then
            radiusBall:Destroy()
        end
        for _, connection in ipairs(connections) do
            connection:Disconnect()
        end
        _G.StopAutoMiner = nil
    end

    _G.StopAutoMiner = stopScript

    -- ==========================================================
    -- CARI POSISI MOUSE / TOUCH
    -- ==========================================================
    local lastX, lastY = nil, nil

    local function isInsidePanel(position)
        local panelPosition = frame.AbsolutePosition
        local panelSize = frame.AbsoluteSize
        return position.X >= panelPosition.X
            and position.X <= panelPosition.X + panelSize.X
            and position.Y >= panelPosition.Y
            and position.Y <= panelPosition.Y + panelSize.Y
    end

    table.insert(connections, UserInputService.InputChanged:Connect(function(input)
        if isMobileMode or input.UserInputType ~= Enum.UserInputType.MouseMovement then
            return
        end
        local position = UserInputService:GetMouseLocation()
        lastX, lastY = math.floor(position.X), math.floor(position.Y)
        positionLabel.Text = string.format("Mouse X: %d | Y: %d", lastX, lastY)
    end))

    local function updateTouch(touch)
        if not isMobileMode or isInsidePanel(touch.Position) then
            return
        end
        local inset = GuiService:GetGuiInset()
        lastX = math.floor(touch.Position.X + inset.X)
        lastY = math.floor(touch.Position.Y + inset.Y)
        positionLabel.Text = string.format("Touch X: %d | Y: %d", lastX, lastY)
    end

    table.insert(connections, UserInputService.TouchStarted:Connect(updateTouch))
    table.insert(connections, UserInputService.TouchMoved:Connect(updateTouch))

    -- ==========================================================
    -- TOMBOL DAN SHORTCUT
    -- ==========================================================
    table.insert(connections, toggleButton.Activated:Connect(toggleMiner))
    table.insert(connections, exitButton.Activated:Connect(stopScript))

    -- MARK: masukkan SP yang sedang dituju ke kolom Skip, cetak posisinya, salin daftarnya
    local function markCurrent()
        if not currentTarget then
            setStatus("Belum ada target untuk di-mark")
            return
        end

        local name = currentTarget.name
        local list = readIgnoreList()
        if not table.find(list, name) then
            table.insert(list, name)
            local position = currentTarget.position
            print(string.format("[MARK] %s = %s, %s, %s", name,
                tostring(position.X), tostring(position.Y), tostring(position.Z)))
        end
        inputIgnore.Text = table.concat(list, ", ")

        local copyFunction = setclipboard or toclipboard
        if copyFunction and pcall(copyFunction, inputIgnore.Text) then
            setStatus(name .. " di-skip, daftar tersalin")
        else
            setStatus(name .. " di-skip (lihat console)")
        end
    end

    table.insert(connections, markButton.Activated:Connect(markCurrent))
    table.insert(connections, pickButton.Activated:Connect(function()
        if lastX and lastY then
            inputX.Text = tostring(lastX)
            inputY.Text = tostring(lastY)
        end
    end))
    table.insert(connections, modeButton.Activated:Connect(function()
        if isActive then
            stopMiner("Mode diganti")
        end
        isMobileMode = not isMobileMode
        lastX, lastY = nil, nil
        applyMode()
    end))

    table.insert(connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed or UserInputService:GetFocusedTextBox() then
            return
        end

        -- 0 dan P hanya berlaku saat tab MINER yang terbuka. X (mark) selalu berlaku.
        if input.KeyCode == Enum.KeyCode.Zero and currentTab == "miner" then
            toggleMiner()
        elseif input.KeyCode == Enum.KeyCode.P and currentTab == "miner" then
            local position = UserInputService:GetMouseLocation()
            inputX.Text = tostring(math.floor(position.X))
            inputY.Text = tostring(math.floor(position.Y))
        elseif input.KeyCode == Enum.KeyCode.X then
            markCurrent()
        end
    end))

    -- ==========================================================
    -- LOOP UTAMA
    -- ==========================================================
    task.spawn(function()
        while isAlive do
            if isActive then
                local success, err = pcall(mineOnce)
                if not success then
                    warn("Auto Miner error: " .. tostring(err))
                    waitFor(1)
                end
            else
                task.wait(0.1)
            end
        end
    end)
end

-- ==========================================================
-- TAMPILKAN DROPPED ITEM (workspace > WorldItems)
-- ==========================================================
do
    local SHOW_DROPS = true   -- false = matikan tanda drop
    local DROP_RADIUS = 100   -- tampilkan drop sejauh ini dari karakter (stud)
    local MAX_DROP_MARKS = 15 -- batas jumlah tanda sekaligus (yang terdekat), supaya ringan
    local DROP_TEXT_SIZE = 22 -- ukuran tulisan nama item

    -- Drop yang TIDAK ditampilkan (cukup sebagian nama, tidak peduli huruf besar/kecil).
    -- Dicek dari nama item, nama PrimaryPart, dan nama bagian di dalamnya (misal Mesh > Tria_Coin).
    local HIDDEN_DROPS = { "Tria_Coin" }

    local function isHiddenDrop(item, part)
        local names = { item.Name:lower(), part and part.Name:lower() or "" }
        for _, keyword in ipairs(HIDDEN_DROPS) do
            local lowerKeyword = keyword:lower()
            for _, name in ipairs(names) do
                if name:find(lowerKeyword, 1, true) then
                    return true
                end
            end
            if item:FindFirstChild(keyword, true) then
                return true
            end
        end
        return false
    end

    -- Warna khusus per item (dicocokkan dari nama, tidak peduli huruf besar/kecil).
    -- Item yang tidak ada di daftar ini memakai hijau.
    local DROP_COLORS = {
        RustyGear = Color3.fromRGB(0, 230, 255),    -- biru cyan
        ScrapMetal = Color3.fromRGB(255, 255, 255), -- putih
    }
    local DEFAULT_DROP_COLOR = Color3.fromRGB(80, 255, 120) -- hijau

    local function getDropColor(displayName, item)
        local check = (displayName .. " " .. item.Name):lower()
        for name, color in pairs(DROP_COLORS) do
            if check:find(name:lower(), 1, true) then
                return color
            end
        end
        return DEFAULT_DROP_COLOR
    end

    local dropMarks = {} -- [item] = { highlight, billboard, label }

    -- Nama yang ditampilkan: attribute nama item kalau ada, kalau tidak nama PrimaryPart
    local function getDisplayName(item)
        local attributeName = item:GetAttribute("ItemName") or item:GetAttribute("Name")
        if type(attributeName) == "string" then
            return attributeName
        end
        local part = item:IsA("Model") and item.PrimaryPart
        local name = part and part.Name or item.Name
        return (name:gsub("^Mat_", ""):gsub("Mesh$", ""))
    end

    local function getItemPart(item)
        if item:IsA("Model") then
            return item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart", true)
        end
        return item:IsA("BasePart") and item or nil
    end

    local function removeDropMark(item)
        local mark = dropMarks[item]
        if mark then
            mark.highlight:Destroy()
            mark.billboard:Destroy()
            dropMarks[item] = nil
        end
    end

    local function getDropMark(item, part)
        if dropMarks[item] then
            return dropMarks[item]
        end
        local highlight = Instance.new("Highlight")
        highlight.FillColor = Color3.fromRGB(80, 255, 120)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.5
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Adornee = item
        highlight.Parent = gui

        local billboard = Instance.new("BillboardGui")
        billboard.Size = UDim2.new(0, 220, 0, 36)
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.AlwaysOnTop = true
        billboard.Adornee = part
        billboard.Parent = gui

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(150, 255, 170)
        label.TextStrokeTransparency = 0 -- garis hitam tebal supaya mudah dibaca
        label.Font = Enum.Font.SourceSansBold
        label.TextSize = DROP_TEXT_SIZE
        label.Parent = billboard

        dropMarks[item] = { highlight = highlight, billboard = billboard, label = label }
        return dropMarks[item]
    end

    if SHOW_DROPS then
        task.spawn(function()
            while isAlive do
                pcall(function()
                    local folder = workspace:FindFirstChild("WorldItems")
                    local _, rootPart = getRoot()
                    local keep = {}

                    if folder and rootPart then
                        -- Kumpulkan drop dalam radius, urut dari yang terdekat
                        local found = {}
                        for _, item in ipairs(folder:GetChildren()) do
                            local part = getItemPart(item)
                            if part and not isHiddenDrop(item, part) then
                                local distance = (part.Position - rootPart.Position).Magnitude
                                if distance <= DROP_RADIUS then
                                    table.insert(found, { item = item, part = part, distance = distance })
                                end
                            end
                        end
                        table.sort(found, function(a, b)
                            return a.distance < b.distance
                        end)

                        for index, entry in ipairs(found) do
                            if index > MAX_DROP_MARKS then
                                break
                            end
                            keep[entry.item] = true
                            local mark = getDropMark(entry.item, entry.part)
                            local displayName = getDisplayName(entry.item)
                            local color = getDropColor(displayName, entry.item)
                            mark.highlight.FillColor = color
                            mark.label.TextColor3 = color
                            mark.label.Text = displayName -- cukup nama, tanpa jarak
                        end
                    end

                    for item in pairs(dropMarks) do
                        if not keep[item] or not item.Parent then
                            removeDropMark(item)
                        end
                    end
                end)
                task.wait(0.5)
            end
            for item in pairs(dropMarks) do
                removeDropMark(item)
            end
        end)
    end
end

